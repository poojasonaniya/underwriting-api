							"query": [
								{
									"key": "taxIdentifier",
									"value": "12345678",
									"description": "Business tax identifier"
								}
							]
						},
						"description": "Get credit score from Experian mock API. This endpoint is mocked using WireMock and returns pre-configured responses based on the tax identifier.\n\nExample tax identifiers:\n- 12345678: High credit score (800)\n- 98765432: Low credit score (300)\n- 44444444: Business not found\n- 11111111: Timeout (31 seconds)\n- 22222222: Service unavailable (503)\n- 33333333: Internal server error (500)"
					},
					"response": [
						{
							"name": "High Credit Score Response",
							"originalRequest": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{experian_base_url}}/api/v1/credit-score?taxIdentifier=12345678",
									"host": [
										"{{experian_base_url}}"
									],
									"path": [
										"api",
										"v1",
										"credit-score"
									],
									"query": [
										{
											"key": "taxIdentifier",
											"value": "12345678"
										}
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n  \"requestId\": \"req-12345678-abcd-1234-5678-1234567890ab\",\n  \"success\": true,\n  \"result\": {\n    \"businessHeader\": {\n      \"bin\": \"123456789\",\n      \"businessName\": \"Test Company Inc.\",\n      \"address\": \"123 Main St, New York, NY 10001\",\n      \"phone\": \"+1-555-123-4567\",\n      \"taxId\": \"12345678\",\n      \"websiteUrl\": \"https://testcompany.com\",\n      \"legalBusinessName\": \"Test Company Incorporated\",\n      \"dbaNames\": [\"Test Co\", \"TC Inc\"]\n    },\n    \"commercialScore\": {\n      \"score\": 800,\n      \"recommendedCreditLimitAmount\": 150000\n    }\n  }\n}"
						}
					]
				},
				{
